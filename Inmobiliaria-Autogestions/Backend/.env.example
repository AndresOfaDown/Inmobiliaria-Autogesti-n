# Puerto del servidor
PORT=3000

# Base de datos PostgreSQL (Prisma)
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BD?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inmobiliaria_db?schema=public"

# Configuración JWT (Autenticación)
JWT_SECRET="super-secreto-cambiar-en-produccion"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="super-refresh-secreto-cambiar-en-produccion"
JWT_REFRESH_EXPIRES_IN="7d"
